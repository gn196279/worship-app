rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userRole() {
      return userDoc().data.role;
    }

    function isAdmin() {
      return isSignedIn()
          && (request.auth.token.admin == true || userRole() == 'admin');
    }

    function isMusicianOrAdmin() {
      return isSignedIn()
          && (userRole() == 'musician' || userRole() == 'admin');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId)
          && request.resource.data.role == 'singer';
      allow update: if isAdmin()
          && request.auth.uid != userId
          && request.resource.data.diff(resource.data).changedKeys()
              .hasOnly(['role']);
      allow update: if isOwner(userId)
          && !request.resource.data.diff(resource.data).changedKeys()
              .hasAny(['role']);
      allow delete: if isAdmin();
    }

    match /songs/{songId} {
      allow read: if isSignedIn();
      allow create: if isMusicianOrAdmin();
      allow update: if isMusicianOrAdmin();
      allow delete: if isAdmin();
    }

    match /sets/{setId} {
      allow read, create: if isSignedIn();
      allow update, delete: if isAdmin() || isOwner(resource.data.createdBy);
    }

    match /notes/{noteId} {
      allow read, create: if isSignedIn();
      allow update, delete: if isAdmin() || isOwner(resource.data.createdBy);
    }
  }
}
